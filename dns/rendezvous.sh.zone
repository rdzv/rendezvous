; Import only into Jonathan's rendezvous.sh zone.
; Set ALL CNAME records to Proxied (orange cloud). TXT records are DNS-only.
; Cloudflare for SaaS validates and renews HTTPS certificates automatically via HTTP.
$ORIGIN rendezvous.sh.
$TTL 300

host IN CNAME connect.rdzv.net.
_cf-custom-hostname.host IN TXT "8e5c164b-da58-4c1c-8d6b-7a0bd6945ebe"

join IN CNAME connect.rdzv.net.
_cf-custom-hostname.join IN TXT "72fb4cbe-17a8-4947-a20b-569cfd14d537"

@ IN CNAME connect.rdzv.net.
_cf-custom-hostname IN TXT "63869076-4e46-4688-9e3b-9301f78abb69"

www IN CNAME connect.rdzv.net.
_cf-custom-hostname.www IN TXT "c95a20bb-1ae6-4fa6-bdb8-46a1d66a8673"
