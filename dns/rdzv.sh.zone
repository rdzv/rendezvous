; Import only into Jonathan's rdzv.sh zone.
; Set ALL CNAME records to Proxied (orange cloud). TXT records are DNS-only.
; Cloudflare for SaaS validates and renews HTTPS certificates automatically via HTTP.
$ORIGIN rdzv.sh.
$TTL 300

host IN CNAME connect.rdzv.net.
_cf-custom-hostname.host IN TXT "750c471b-306c-4096-8188-12965aece0d2"

join IN CNAME connect.rdzv.net.
_cf-custom-hostname.join IN TXT "3986970e-18f4-4107-a972-9cc490d3abd5"

@ IN CNAME connect.rdzv.net.
_cf-custom-hostname IN TXT "b9219812-4151-4e1b-806f-ae2447fa7398"

www IN CNAME connect.rdzv.net.
_cf-custom-hostname.www IN TXT "02d2d5f2-8106-4a1b-8d36-d86cdab6e6ce"
